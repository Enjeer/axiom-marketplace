# --- Supabase (public / browser-safe) ---
# Эти ключи используются в браузере и на сервере SSR.
# Значения берутся из Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# --- Supabase (server-only) ---
# НЕ добавляй префикс VITE_ — этот ключ обходит RLS и не должен попадать в клиент.
# Значение берётся из Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Опционально: для локального обхода CSRF/безопасности в dev-режиме
# NODE_ENV=development

# --- n8n webhooks (server-only) ---
N8N_BASE_URL=https://n8n.aorm.online
N8N_WEBHOOK_SALES_LEAD_QUALIFIER=https://n8n.aorm.online/webhook/sales-lead-qualifier
N8N_WEBHOOK_PDF_EXTRACTOR=https://n8n.aorm.online/webhook-test/extract-pdf
N8N_WEBHOOK_TIMEOUT_MS=120000
