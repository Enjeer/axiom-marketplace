@@ -4,3 +4,26 @@ import { twMerge } from "tailwind-merge";
 export function cn(...inputs: ClassValue[]) {
   return twMerge(clsx(inputs));
 }
+
+/**
+ * Automation/webhook outputs sometimes arrive as a raw JSON string like
+ * `{"text": "..."}` instead of plain text. Unwrap that shape when present
+ * so the UI can render the actual content (and markdown inside it) instead
+ * of the JSON envelope. Falls back to the raw string when it isn't JSON or
+ * doesn't match the expected shape.
+ */
+export function extractResultText(raw: string): string {
+  const trimmed = raw.trim();
+  if (!trimmed.startsWith("{") && !trimmed.startsWith("[")) return raw;
+  try {
+    const parsed = JSON.parse(trimmed);
+    if (typeof parsed === "string") return parsed;
+    if (parsed && typeof parsed === "object") {
+      const candidate = parsed.text ?? parsed.output ?? parsed.message;
+      if (typeof candidate === "string") return candidate;
+    }
+  } catch {
+    // Not valid JSON — show the raw text as-is.
+  }
+  return raw;
+}
